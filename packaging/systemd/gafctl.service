[Unit]
Description=Gafctl GAF Master Flow attic fan service
Wants=network-online.target
After=network-online.target bluetooth.service

[Service]
User=gafctl
Group=gafctl
StateDirectory=gafctl
StateDirectoryMode=0700
Environment=GAFCTL_IDENTITY_STORE=/var/lib/gafctl/identities.json
EnvironmentFile=/etc/gafctl/gafctl.env
ExecStart=/usr/bin/gafctl-server --bind 127.0.0.1:8787
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
