# Copy to /etc/gafctl/gafctl.env for systemd, or ./gafctl.env for Compose.
# Set the Bluetooth ID from gafctl ble scan for an original controller.
# GAFCTL_DEVICE_ID=PERIPHERAL_ID
# QuickConnect: use a private password file, never a command-line password.
# GAFCTL_QUICKCONNECT_USERNAME=YOUR_ACCOUNT_LOGIN
# GAFCTL_QUICKCONNECT_PASSWORD_FILE=/etc/gafctl/quickconnect-password
# GAFCTL_QUICKCONNECT_ROLE=consumer
# QuickConnect writes are experimental and disabled by default.
# GAFCTL_QUICKCONNECT_WRITES_ENABLED=true
# MQTT requires both a username and password.
# GAFCTL_MQTT_HOST=BROKER_HOST
# GAFCTL_MQTT_PORT=1883
# GAFCTL_MQTT_USERNAME=YOUR_MQTT_USER
# GAFCTL_MQTT_PASSWORD=YOUR_MQTT_PASSWORD
# GAFCTL_MQTT_DISCOVERY=true
